library(ape)
library(phangorn)   # for plotBS
library(ggtree)
library(ggplot2)

# run mafft
mafft --auto --thread 50 ancient.fasta > ancient.aln

# split sequences with split_aln.py
python split_aln.py

# run RAxML
raxml-ng --all --msa ancient.core.aln --model GTR+G --seed 1243 --threads 44 --prefix ancient_core2 --redo

region1 <- "ancient_core2"
#region1 <- "core" # with all LSDV

# --- Load RAxML best tree ---
tree_file <- paste0(region1, ".raxml.bestTree")
tree_all <- read.tree(tree_file)

# --- Load RAxML bootstraps ---
boot_file <- paste0(region1, ".raxml.bootstraps")
boots <- read.tree(boot_file)
boots <- structure(boots, class = "multiPhylo")  # ensure phangorn compatibility

# --- Chordopox outgroup (tips) + species names ---
chordopox_tips <- c(
  "NC_006966.1", "NC_002642.1", "NC_005179.1",
  "NC_016924.1", "NC_032111.1", "NC_001266.1",
  "NC_001132.2", "NC_003389.1", "NC_035460.1" )
# deerpox virus NC_006966.1, Yaba-like disease virus NC_002642.1, Yaba monkeypox tumour virus NC_005179.1, Cotia virus NC_016924.1, BeAn virus NC_032111.1, Rabbit fibroma virus NC_001266.1, Myxoma virus NC_001132.2, Swinepox virus NC_003389.1, and Eptesipox virus NC_035460.1.
chordopox_names <- c(
  "NC_006966.1" = "Deerpox virus",
  "NC_002642.1" = "Yaba-like disease virus",
  "NC_005179.1" = "Yaba monkeypox tumour virus",
  "NC_016924.1" = "Cotia virus",
  "NC_032111.1" = "BeAn virus",
  "NC_001266.1" = "Rabbit fibroma virus",
  "NC_001132.2" = "Myxoma virus",
  "NC_003389.1" = "Swinepox virus",
  "NC_035460.1" = "Eptesipox virus",
  "NC_004003.1" = "Goatpox virus",
  "NC_004002.1" = "Sheeppox virus",
  "LSDV_AF325528" = "Lumpy skin disease virus")

# --- Root tree at chordopox MRCA ---
og <- intersect(chordopox_tips, tree_all$tip.label)
if(length(og) >= 2){
  root_node <- getMRCA(tree_all, og)
  tree_all <- root(tree_all, node = root_node, resolve.root = FALSE)
  boots <- lapply(boots, root, node = root_node, resolve.root = FALSE)
  boots <- structure(boots, class = "multiPhylo") }
tree_all <- ladderize(tree_all)

tree_all_bs <- plotBS(tree_all, boots, p=50, type="none")  
tt <- ggtree(tree_all_bs)
tt$data$boot <- NA
internal_nodes <- tt$data$node > length(tree_all_bs$tip.label)
tt$data$boot[internal_nodes] <- round(100*as.numeric(tree_all_bs$node.label),0)
boot_nodes <-tt$data[internal_nodes & !is.na(tt$data$boot) & as.numeric(tt$data$boot) > 80, ]

tt$data$group <- ifelse(grepl("^LSDV", tt$data$label), "LSDV",
                   ifelse(grepl("^KX8", tt$data$label), "LSDV",
                   ifelse(grepl("^GTPV", tt$data$label), "GTPV",
                   ifelse(grepl("^SPPV", tt$data$label), "SPPV",
                   ifelse(grepl("^NC_004002", tt$data$label), "SPPV",
                   ifelse(grepl("^NC_004003", tt$data$label), "GTPV",
                          "Other") )))))

tip_labels <- tt$data$label
tip_labels[tt$data$group %in% c("LSDV","GTPV","SPPV")] <- ""
tip_labels[tip_labels %in% names(chordopox_names)] <-
    chordopox_names[tip_labels[tip_labels %in% names(chordopox_names)]]

    p_tree_all <- tt +
  geom_tippoint(aes(color=group), size=2.5) +
  geom_tiplab(aes(label=tip_labels), size=3.2) +
  geom_text2(data=boot_nodes, aes(label=boot), hjust=1.2, vjust=-.6, size=2.5) +
  theme_tree2() +  coord_cartesian(clip="off") +
  theme(    plot.margin = margin(0, 30, 0, 0, "mm"),
    legend.position = c(1, 1),           # Position at top-right (x=1, y=1)
    legend.justification = c(1, 1),      # Anchor at top-right corner
    legend.text = element_text(size=16), # Bigger legend text
    legend.title = element_text(size=0), 
    legend.key.size = unit(2, "cm")     ) +
  scale_color_manual(values = c(
    LSDV = "darkgreen", GTPV = "blue", SPPV = "red", Chordopox = "black"  )) +
  guides(color = guide_legend(override.aes = list(size = 6))) 
ggsave(paste0("GENOME/",region1,".tree.tips.pdf"), p_tree_all, width=11,height=7)
